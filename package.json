{
  "name": "@skastr0/parallel-cli",
  "version": "0.1.0",
  "description": "JSON-first Effect CLI for Parallel API operations.",
  "type": "module",
  "private": true,
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "bun run ./src/cli.ts",
    "build": "bun scripts/build.ts",
    "package:release": "bun scripts/package-release.ts",
    "package:npm": "bun scripts/package-npm.ts",
    "npm:dry-run": "bun scripts/npm-pack-dry-run.ts",
    "publish:npm:ci": "bun scripts/npm-publish-ci.ts",
    "install:local": "bun scripts/install.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify": "bun run typecheck && bun run test && bun run build",
    "verify:release": "bun run verify && bun run package:release && bun run package:npm && bun run npm:dry-run"
  },
  "keywords": [
    "parallel",
    "parallel-api",
    "cli",
    "effect",
    "agent"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/skastr0/parallel-cli.git"
  },
  "homepage": "https://github.com/skastr0/parallel-cli#readme",
  "bugs": {
    "url": "https://github.com/skastr0/parallel-cli/issues"
  },
  "overrides": {
    "uuid": "^11.1.1",
    "ws": "^8.20.1"
  },
  "dependencies": {
    "@effect/cli": "^0.75.0",
    "@effect/platform": "^0.96.0",
    "@effect/platform-bun": "^0.89.0",
    "effect": "^3.21.0"
  },
  "devDependencies": {
    "@effect/vitest": "^0.29.0",
    "@types/bun": "^1.3.11",
    "typescript": "^6.0.3",
    "vitest": "^4.1.2"
  }
}
